# ---- Blaze & Bun: environment template ----
# Copy to .env.local and fill in REAL values. Never commit real secrets.
# This file is a safe, committable template with PLACEHOLDER names only.

# Postgres via the shared transaction-mode pooler (IPv4) — used at runtime by Prisma.
# NOTE: replace USER:PASSWORD and HOST with your real pooler URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Postgres via the shared session-mode pooler — used for `prisma migrate dev`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase (server-only). Service role bypasses RLS — never expose to the client.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Phase 2+ (fill when reached) ----
# Resend (transactional email; password reset / email verification tokens)
RESEND_API_KEY="re_..."
EMAIL_FROM="Blaze & Bun <orders@example.com>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Signed-in session / refresh-token signing secrets (>=32 chars, random).
SESSION_SECRET="replace-with-64-char-random-hex"
REFRESH_SECRET="replace-with-64-char-random-hex"

# Optional: dedicated secret for anonymous guest tokens (>=32 chars).
# If unset, guest tokens fall back to REFRESH_SECRET.
GUEST_SECRET=""

# Optional: seed the demo admin account with this password (fallback: demo).
ADMIN_SEED_PASSWORD="replace-with-a-strong-admin-password"

# RediSearch / Redis (server-only). Optional — when unset the app runs on an
# in-memory fallback for caching & rate limiting (single-instance only).
# Example: redis://default:PASSWORD@HOST:6379  (Upstash: rediss://...)
REDIS_URL=""

# Stripe (server-only, test mode for now)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Publishable key — exposed to the client to load Stripe.js (never the secret).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Mapbox Geocoding (server-only)
MAPBOX_ACCESS_TOKEN="pk.xxx"

# S3-compatible / Supabase Storage bucket for image uploads (server-only)
STORAGE_BUCKET="menu-images"

# Google OAuth (optional — if not set, the "Continue with Google" button shows a
# clear fallback message instead of dead-ending.  Create credentials at
# https://console.cloud.google.com/apis/credentials and add
# http://localhost:3000/api/auth/google/callback as an authorised redirect URI.)
# NOTE: .env.example is a committed template. Never put real secrets here —
# keep them in the gitignored .env.local.
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"
